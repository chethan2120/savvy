# Supabase — browser-safe values only. Publishable key, never a service-role key.
# Either pair works. This app is Next.js, so VITE_* is mapped onto NEXT_PUBLIC_*.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side only. Never prefix this with NEXT_PUBLIC_ and never import it
# from client components. The current app does not use it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required on Vercel. At least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
